diff --git a/externals/switch-compat/include/glad_compat.h b/externals/switch-compat/include/glad_compat.h
index 4c86b50..ebc3443 100644
--- a/externals/switch-compat/include/glad_compat.h
+++ b/externals/switch-compat/include/glad_compat.h
@@ -16,11 +16,49 @@
 #define GLAD_GL_KHR_debug false
 #define GLAD_GL_VERSION_3_3 true
 #define GLAD_GL_ES_VERSION_3_1 false
+/* baske: what used to be here was a layer of ~1362 blocks doing "#undef glFoo" followed by
+ * "#define glFoo __glFoo". That KILLED glsym's macros --which do work, because glsym_gl.c
+ * defines the __rglgen_* pointers and rglgen_resolve_symbols() fills them-- and replaced
+ * them with a __gl* layer NOBODY defines or resolves: ~134 symbols were left unresolved at
+ * link time. It was half of a mechanism that was never finished (the other half was
+ * rglgen_symbol_map_citra, which does not exist either). With the blocks gone, each glFoo
+ * resolves again through nx_glsym.h / glsym_gl.h, which is the complete layer.
+ * Only the three glsym does not provide are kept, and we define those in switch-compat.c. */
+
+/* baske: this compat was written for an older Citra and the emulator went on adding
+ * extension checks (gl_driver.cpp), so these 14 were missing.
+ * They all go in as false --extension not available--, the conservative choice the
+ * original author already made with the ones above: Citra takes the compatible path.
+ * GLAD_GL_VERSION_4_3 goes in as false too, so as not to contradict the 3_3 = true above;
+ * if GL 4.3 is ever needed, the two have to be looked at together. */
+#define GLAD_GL_AMD_blend_minmax_factor false
+#define GLAD_GL_ARB_clear_texture false
+#define GLAD_GL_ARB_fragment_shader_interlock false
+#define GLAD_GL_ARB_get_texture_sub_image false
+#define GLAD_GL_ARB_texture_compression_bptc false
+#define GLAD_GL_ARM_shader_framebuffer_fetch false
+#define GLAD_GL_ES_VERSION_3_2 false
+#define GLAD_GL_EXT_buffer_storage false
+#define GLAD_GL_EXT_shader_framebuffer_fetch false
+#define GLAD_GL_EXT_texture_compression_s3tc false
+#define GLAD_GL_INTEL_fragment_shader_ordering false
+#define GLAD_GL_NV_blend_minmax_factor false
+#define GLAD_GL_NV_fragment_shader_interlock false
+#define GLAD_GL_VERSION_4_3 false
 
 #define GL_TEXTURE_3D_OES GL_TEXTURE_3D
 #define GL_TEXTURE_BINDING_3D_OES GL_TEXTURE_BINDING_3D
 
-void glTextureBarrier() {}
+/* baske: Citra uses the ASTC enums with no suffix and the GL headers only bring the _KHR
+ * variant (the one the KHR_texture_compression_astc_ldr extension defines). The same
+ * treatment as the GL_TEXTURE_3D_OES aliases above. */
+#define GL_COMPRESSED_RGBA_ASTC_4x4 GL_COMPRESSED_RGBA_ASTC_4x4_KHR
+#define GL_COMPRESSED_RGBA_ASTC_6x6 GL_COMPRESSED_RGBA_ASTC_6x6_KHR
+#define GL_COMPRESSED_RGBA_ASTC_8x6 GL_COMPRESSED_RGBA_ASTC_8x6_KHR
+
+/* baske: inline. Defined the other way in a header included by many TU it gave
+ * "multiple definition of glTextureBarrier" at link time. */
+inline void glTextureBarrier() {}
 
 #define GL_SRC1_COLOR_EXT 0x88F9
 #define GL_SRC1_ALPHA_EXT 0x8589
@@ -34,7 +72,11 @@ void glTextureBarrier() {}
 #include <EGL/egl.h>
 //#include <EGL/eglext.h>
 
-extern PFNGLBINDFRAGDATALOCATIONINDEXEDEXTPROC __glBindFragDataLocationIndexedEXT;
+/* baske: the three types below do not exist; the right names are the ones the compiler
+ * suggests. All three functions sit behind GLAD_GL_* flags that are false, so they are
+ * never called, but they still have to be declared and to link (they are defined in
+ * switch-compat.c, as NULL). */
