 #endif
@@ -36,6 +68,35 @@ public:
 #    else
         m_memory = (std::uint32_t*)mmap(nullptr, size, PROT_READ | PROT_WRITE | PROT_EXEC, MAP_ANON | MAP_PRIVATE | MAP_JIT, -1, 0);
 #    endif
+#elif defined(__SWITCH__)
+        // A normal backing plus an executable alias onto the very same physical pages.
+        m_src = std::aligned_alloc(0x1000, (size + 0xFFF) & ~std::size_t{0xFFF});
+        if (m_src != nullptr) {
+            m_size = (size + 0xFFF) & ~std::size_t{0xFFF};
+            virtmemLock();
+            void* alias = virtmemFindCodeMemory(m_size, 0x1000);
+            if (alias != nullptr)
