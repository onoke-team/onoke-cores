+#    include <cstddef>
+#    include <cstdlib>
+extern "C" {
+struct VirtmemReservation;
+unsigned int svcMapProcessCodeMemory(unsigned int proc, unsigned long dst, unsigned long src, unsigned long size);
+unsigned int svcUnmapProcessCodeMemory(unsigned int proc, unsigned long dst, unsigned long src, unsigned long size);
+unsigned int svcSetProcessMemoryPermission(unsigned int proc, unsigned long addr, unsigned long size, unsigned int perm);
+unsigned int envGetOwnProcessHandle(void);
+void virtmemLock(void);
+void virtmemUnlock(void);
+void* virtmemFindCodeMemory(std::size_t size, std::size_t guard_size);
+struct VirtmemReservation* virtmemAddReservation(void* mem, std::size_t size);
+void virtmemRemoveReservation(struct VirtmemReservation* rv);
+void armDCacheFlush(void* addr, std::size_t size);
+void armICacheInvalidate(void* addr, std::size_t size);
