+                                        (unsigned long)m_src, m_size) == 0) {
+                m_memory = (std::uint32_t*)alias;
+                printf("[JIT] bloque de codigo mapeado en %p (%u bytes)\n",
+                       (void*)alias, (unsigned)m_size);
+                // baske: an EXPLICIT initial permission. Freshly mapped, the alias is
