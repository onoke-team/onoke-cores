 #endif
@@ -51,6 +112,14 @@ public:
 
 #if defined(_WIN32)
         VirtualFree((void*)m_memory, 0, MEM_RELEASE);
+#elif defined(__SWITCH__)
+        svcUnmapProcessCodeMemory(envGetOwnProcessHandle(), (unsigned long)m_memory,
