+        if (rc == 0)
+            return;
+        static bool avisado_rw = false, avisado_rx = false;
+        bool& avisado = (perm == OAKNUT_NX_PERM_RW) ? avisado_rw : avisado_rx;
+        if (avisado)
+            return;
+        avisado = true;
+        printf("[JIT] svcSetProcessMemoryPermission(%s) FALLO rc=0x%x en %p (%u bytes). El JIT va a usar memoria sin el permiso que corresponde y va a crashear.\n", que, rc, (void*)m_memory, (unsigned)m_size);
+    }
+#endif
