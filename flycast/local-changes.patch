diff --git a/core/libretro/common.cpp b/core/libretro/common.cpp
index ea24223..c97eb4e 100644
--- a/core/libretro/common.cpp
+++ b/core/libretro/common.cpp
@@ -297,7 +297,12 @@ static void sigill_handler(int sn, siginfo_t * si, void *segfault_ctx)
 //#define LOG_SIGHANDLER
 
 #ifdef HAVE_LIBNX
-extern "C" char __start__;
+// baske: __start__ is defined by libnx's linker script when it builds a .nro. Our core
+// is loaded as a dynamic .so, so that symbol does NOT exist and the loader failed with
+// "unresolved external symbol: __start__". It is only used to log the base of .text
+// after a segfault, so any address INSIDE the module will do: we use a function of our
+// own, which lives in the core's .text.
+static void nx_module_anchor(void) { }
 #endif // HAVE_LIBNX
 
 #if !defined(TARGET_NO_EXCEPTIONS)
@@ -403,7 +408,7 @@ static void signal_handler(int sn, siginfo_t * si, void *segfault_ctx)
 #ifdef HAVE_LIBNX
     MemoryInfo meminfo;
     u32 pageinfo;
-    svcQueryMemory(&meminfo, &pageinfo, (u64)&__start__);
+    svcQueryMemory(&meminfo, &pageinfo, (u64)&nx_module_anchor);
    	ERROR_LOG(COMMON, ".text base: %p", meminfo.addr);
 #endif // HAVE_LIBNX
    	die("segfault");
diff --git a/core/libretro/vmem_utils.cpp b/core/libretro/vmem_utils.cpp
index f1d6fa0..cb6ca2a 100644
--- a/core/libretro/vmem_utils.cpp
+++ b/core/libretro/vmem_utils.cpp
@@ -139,10 +139,41 @@ bool mem_region_set_exec(void *start, size_t len)
 	return true;
 }
 
+#ifdef HAVE_LIBNX
+// baske: virtmemReserve() was REMOVED from libnx; Flycast still uses it. The equivalent
+// with today's API (virtmemLock + virtmemFindAslr + virtmemAddReservation), the same
+// fix already made to mupen64plus-next in switch/mman.h.
+// We do not keep the VirtmemReservation*: there is no virtmemFree anywhere in this
+// tree, so Flycast never frees these reservations and they last as long as the process.
+// baske: for svcMapProcessCodeMemory libnx wants an address from the CODE MEMORY
+// region, which is NOT the ASLR region. Using virtmemFindAslr here makes the JIT's
+// mapping land on top of the heap and overwrite memory already reserved (the symptom:
+// the SH4 writes to a valid address in mem_b and gets a Data Abort, the page is gone).
+static inline void *nx_virtmem_reserve_code(size_t size)
+{
+	virtmemLock();
+	void *p = virtmemFindCodeMemory(size, 0);
+	if (p != NULL)
+		virtmemAddReservation(p, size);
+	virtmemUnlock();
+	return p;
+}
+
+static inline void *nx_virtmem_reserve(size_t size)
+{
+	virtmemLock();
+	void *p = virtmemFindAslr(size, 0);
+	if (p != NULL)
+		virtmemAddReservation(p, size);
+	virtmemUnlock();
+	return p;
+}
+#endif
+
 void *mem_region_reserve(void *start, size_t len)
 {
 #ifdef HAVE_LIBNX
-	return virtmemReserve(len);
+	return nx_virtmem_reserve(len);
 #else
 	void *p = mmap(start, len, PROT_NONE, MAP_PRIVATE | MAP_ANON, -1, 0);
 	if (p == MAP_FAILED)
@@ -243,7 +274,7 @@ VMemType vmem_platform_init(void **vmem_base_addr, void **sh4rcb_addr) {
 	if (vmem_fd_page < 0)
 		return MemTypeError;
 
-	vmem_fd_codememory = (uintptr_t)virtmemReserve(size_aligned);
+	vmem_fd_codememory = (uintptr_t)nx_virtmem_reserve_code(size_aligned);
 	
 	if(R_FAILED(svcMapProcessCodeMemory(envGetOwnProcessHandle(), (u64) vmem_fd_codememory, (u64) vmem_fd_page, size_aligned)))
 		printf("Failed to Map memory (platform_int)...\n");
@@ -388,7 +419,7 @@ bool vmem_platform_prepare_jit_block(void *code_area, unsigned size, void **code
 	void *ptr_rw = mmap(NULL, size, PROT_READ | PROT_WRITE,
 	                    MAP_SHARED | MAP_NOSYNC, shmem_fd2, 0);
 #else
-	void* ptr_rw = virtmemReserve(size_aligned);
+	void* ptr_rw = nx_virtmem_reserve(size_aligned);
 	if(R_FAILED(svcMapProcessMemory(ptr_rw, envGetOwnProcessHandle(), (u64)code_area, size_aligned)))
 		printf("Failed to map jit rw block...\n");
 #endif // HAVE_LIBNX
diff --git a/link.T b/link.T
index 9e82b5d..9491d04 100644
--- a/link.T
+++ b/link.T
@@ -1,4 +1,9 @@
 {
-   global: retro_*;
+   /* baske: __libnx_exception_handler has to stay VISIBLE. libnx declares it weak and
+      gives up on exception handling if it is not defined; the APPLICATION provides it,
+      not a library. Our core is loaded as a .so after libnx's crt0 has already been
+      linked, so the host looks for it here and forwards it. Without this, every page
+      fault Flycast expects to catch (that is how it emulates memory) is a hard crash. */
+   global: retro_*; __libnx_exception_handler;
    local: *;
 };
