diff --git a/Makefile.common b/Makefile.common
index 46ce06f..fdf52e6 100644
--- a/Makefile.common
+++ b/Makefile.common
@@ -458,7 +458,19 @@ SOURCES_CXX += $(CORE_DIR)/core/libretro/libretro.cpp \
 # compiles these libretro-common sources; building them again would duplicate
 # symbols at link time. The headers stay -- they now match current upstream, so
 # the declarations agree with the objects RetroArch provides.
-ifneq ($(STATIC_LINKING), 1)
+# baske: BASKE_LIBRETRO_COMMON=1 forces them in anyway. Our frontend is NOT RetroArch:
+# we relink this .a as a standalone .so, so nobody brings libretro-common from outside
+# and there is no risk of duplicate symbols. Without it the .so is left with ~40
+# unresolved symbols (filestream_*, path_*, retro_dirent_*, slock_*, scond_*,
+# sthread_*) and the loader fails to load it.
+NEED_LR_COMMON = 0
+ifeq ($(BASKE_LIBRETRO_COMMON), 1)
+	NEED_LR_COMMON = 1
+else ifneq ($(STATIC_LINKING), 1)
+	NEED_LR_COMMON = 1
+endif
+
+ifeq ($(NEED_LR_COMMON), 1)
 SOURCES_C += $(LIBRETRO_COMM_DIR)/memmap/memalign.c \
 					$(LIBRETRO_COMM_DIR)/file/file_path.c \
 					$(LIBRETRO_COMM_DIR)/file/file_path_io.c \
@@ -480,7 +492,7 @@ endif
 
 ifeq ($(NO_THREADS), 1)
 else
-ifneq ($(STATIC_LINKING), 1)
+ifeq ($(NEED_LR_COMMON), 1)
 	SOURCES_C += $(LIBRETRO_COMM_DIR)/rthreads/rthreads.c
 endif
 endif
diff --git a/core/hw/mem/_vmem.cpp b/core/hw/mem/_vmem.cpp
index 6a8b342..3c99257 100644
--- a/core/hw/mem/_vmem.cpp
+++ b/core/hw/mem/_vmem.cpp
@@ -479,19 +479,44 @@ bool _vmem_reserve(void)
 		virt_ram_base = 0;
 
 		// Allocate it all and initialize it.
+		// baske: NONE of these allocations checked its result, and the first one asks
+		// for ~128 MB CONTIGUOUS (fpcb is RAM_SIZE_MAX/2 pointers). If it fails, the
+		// crash turns up much later and looks unrelated: a NULL inside
+		// _vmem_WriteMem32 when the SH4 writes memory. Each one is logged.
 		p_sh4rcb = (Sh4RCB*)malloc_pages(sizeof(Sh4RCB));
+		NOTICE_LOG(VMEM, "[baske] p_sh4rcb=%p (%zu MB)", (void*)p_sh4rcb, sizeof(Sh4RCB) >> 20);
+		if (p_sh4rcb == NULL) { ERROR_LOG(VMEM, "[baske] FALLO la reserva de Sh4RCB"); return false; }
 #if FEAT_SHREC != DYNAREC_NONE
 		bm_vmem_pagefill((void**)p_sh4rcb->fpcb, sizeof(p_sh4rcb->fpcb));
 #endif
 
 		mem_b.size = RAM_SIZE;
 		mem_b.data = (u8*)malloc_pages(RAM_SIZE);
+		NOTICE_LOG(VMEM, "[baske] mem_b=%p", (void*)mem_b.data);
+		if (mem_b.data == NULL) { ERROR_LOG(VMEM, "[baske] FALLO la reserva de mem_b"); return false; }
 
 		vram.size = VRAM_SIZE;
 		vram.data = (u8*)malloc_pages(VRAM_SIZE);
+		NOTICE_LOG(VMEM, "[baske] vram=%p (&vram=%p)", (void*)vram.data, (void*)&vram);
+		if (vram.data == NULL) { ERROR_LOG(VMEM, "[baske] FALLO la reserva de vram"); return false; }
 
 		aica_ram.size = ARAM_SIZE;
 		aica_ram.data = (u8*)malloc_pages(ARAM_SIZE);
+		NOTICE_LOG(VMEM, "[baske] aica_ram=%p", (void*)aica_ram.data);
+		if (aica_ram.data == NULL) { ERROR_LOG(VMEM, "[baske] FALLO la reserva de aica_ram"); return false; }
+
+		// baske: a write test. The crash on the Switch is a Data Abort writing to a
+		// VALID address inside mem_b (mem_b+0xc0a00, say), which means the page is not
+		// mapped. This tells the two cases apart: if it fails HERE the reservation is
+		// lying (it handed back a pointer with no memory behind it); if it passes, the
+		// reservation is fine and something unmaps it LATER.
+		NOTICE_LOG(VMEM, "[baske] tocando %u MB de mem_b...", (u32)(RAM_SIZE >> 20));
+		for (size_t off = 0; off < RAM_SIZE; off += 4096)
+			((volatile u8*)mem_b.data)[off] = 0;
+		NOTICE_LOG(VMEM, "[baske] mem_b OK: %u MB escribibles", (u32)(RAM_SIZE >> 20));
+		for (size_t off = 0; off < sizeof(Sh4RCB); off += 4096)
+			((volatile u8*)p_sh4rcb)[off] = ((volatile u8*)p_sh4rcb)[off];
+		NOTICE_LOG(VMEM, "[baske] p_sh4rcb OK: %u MB accesibles", (u32)(sizeof(Sh4RCB) >> 20));
 	}
 	else {
 		NOTICE_LOG(VMEM, "Info: nvmem is enabled, with addr space of size %s", vmemstatus == MemType4GB ? "4GB" : "512MB");
diff --git a/core/hw/pvr/pvr_mem.cpp b/core/hw/pvr/pvr_mem.cpp
index e08b98b..05ed708 100644
--- a/core/hw/pvr/pvr_mem.cpp
+++ b/core/hw/pvr/pvr_mem.cpp
@@ -204,6 +204,17 @@ void DYNACALL pvr_write_area1(u32 addr, T data)
 		INFO_LOG(MEMORY, "%08x: 8-bit VRAM writes are not possible", addr);
 		return;
 	}
+	// baske (diagnostics, once only): the crash is a Data Abort on the str below, with
+	// a base pointer that is NOT the one _vmem_reserve reserved. We print where the
+	// global lives and what is inside it, to see whether something overwrote it later.
+	{
+		static bool loggedOnce = false;
+		if (!loggedOnce) {
+			loggedOnce = true;
+			NOTICE_LOG(MEMORY, "[baske] &vram=%p vram.data=%p size=%u",
+			           (void*)&vram, (void*)vram.data, (unsigned)vram.size);
+		}
+	}
 	u32 vaddr = addr & VRAM_MASK;
 	if (vaddr >= fb_watch_addr_start && vaddr < fb_watch_addr_end)
 		fb_dirty = true;
