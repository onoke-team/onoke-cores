diff --git a/Common/MemArenaHorizon.cpp b/Common/MemArenaHorizon.cpp
index 380fc1a..58e83f6 100644
--- a/Common/MemArenaHorizon.cpp
+++ b/Common/MemArenaHorizon.cpp
@@ -25,6 +25,29 @@ static uintptr_t memoryBase = 0;
 static uintptr_t memoryCodeBase = 0;
 static uintptr_t memorySrcBase = 0;
 
+// baske: libnx removed virtmemReserve(). The modern replacement is to look for a gap
+// in the right region and register it, under virtmemLock(). It is the same patch we
+// applied to flycast (core/libretro/vmem_utils.cpp).
+//   - virtmemFindAslr       -> normal memory (the one mapped with svcMapProcessMemory)
+//   - virtmemFindCodeMemory -> code memory (svcMapProcessCodeMemory, Perm_Rx)
+static void *nx_virtmem_reserve(size_t size) {
+	virtmemLock();
+	void *p = virtmemFindAslr(size, 0);
+	if (p != NULL)
+		virtmemAddReservation(p, size);
+	virtmemUnlock();
+	return p;
+}
+
+static void *nx_virtmem_reserve_code(size_t size) {
+	virtmemLock();
+	void *p = virtmemFindCodeMemory(size, 0);
+	if (p != NULL)
+		virtmemAddReservation(p, size);
+	virtmemUnlock();
+	return p;
+}
+
 size_t MemArena::roundup(size_t x) {
 	return x;
 }
@@ -69,10 +92,10 @@ u8 *MemArena::Find4GBBase() {
 	memorySrcBase = (uintptr_t)memalign(0x1000, 0x10000000);
 
 	if (!memoryBase)
-		memoryBase = (uintptr_t)virtmemReserve(0x10000000);
+		memoryBase = (uintptr_t)nx_virtmem_reserve(0x10000000);
 
 	if (!memoryCodeBase)
-		memoryCodeBase = (uintptr_t)virtmemReserve(0x10000000);
+		memoryCodeBase = (uintptr_t)nx_virtmem_reserve_code(0x10000000);
 
 	if (R_FAILED(svcMapProcessCodeMemory(envGetOwnProcessHandle(), (u64)memoryCodeBase, (u64)memorySrcBase, 0x10000000)))
 		printf("Failed to map memory...\n");
