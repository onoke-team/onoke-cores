diff --git a/glslang/CMakeLists.txt b/glslang/CMakeLists.txt
index 7d8790c..5d65973 100644
--- a/glslang/CMakeLists.txt
+++ b/glslang/CMakeLists.txt
@@ -33,7 +33,10 @@
 
 if(WIN32)
     add_subdirectory(OSDependent/Windows)
-elseif(UNIX OR "${CMAKE_SYSTEM_NAME}" STREQUAL "Fuchsia")
+# baske: on the Switch (CMAKE_SYSTEM_NAME=NintendoSwitch) neither WIN32 nor UNIX is
+# defined, so NO OSDependent was built and the 7 glslang::OS_* (TLS and locks) were left
+# unresolved. libnx brings pthreads, which is what the Unix implementation uses.
+elseif(UNIX OR USE_LIBNX OR "${CMAKE_SYSTEM_NAME}" STREQUAL "Fuchsia")
     add_subdirectory(OSDependent/Unix)
 else()
     message("unknown platform")
