diff --git a/glsym/glsym_gl.c b/glsym/glsym_gl.c
index a5ce04e..3173a20 100644
--- a/glsym/glsym_gl.c
+++ b/glsym/glsym_gl.c
@@ -22,6 +22,9 @@
 
 #include <stddef.h>
 
+/* baske: this is the only TU that DEFINES the plain pointers from nx_glsym.h (the
+ * very ones SYM() takes the address of below, for the resolution map). */
+#define NXGLSYM_LINKAGE
 #include <glsym/glsym.h>
 
 #define SYM(x) { "gl" #x, (void*)&(gl##x) }
diff --git a/include/glsym/switch/nx_glsym.h b/include/glsym/switch/nx_glsym.h
index 94863eb..4ebfad6 100644
