+++ b/include/glsym/switch/nx_glsym.h
@@ -5,6 +5,16 @@
 extern "C" {
 #endif
 
+/* baske: this header DEFINED the pointers (with no extern). In C those were tentative
+ * definitions and the -fcommon of GCC <10 merged them, but PPSSPP includes it from 19
+ * C++ files, where tentative definitions do not exist -> 8226 "multiple definition"
+ * at link time. They are now declared extern by default, and glsym_gl.c -- the only TU
+ * that also registers them in rglgen_symbol_map with SYM() -- defines NXGLSYM_LINKAGE
+ * empty so the definitions are emitted once. */
+#ifndef NXGLSYM_LINKAGE
+#define NXGLSYM_LINKAGE extern
+#endif
