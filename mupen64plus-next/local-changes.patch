@@ -22,15 +22,21 @@ extern "C"
 
 #define MAP_FAILED ((void *)-1)
 void* ptr_rw = NULL;
+static VirtmemReservation* nxjit_rv = NULL;   // the virtual range reserved (new API)
 
+// maps the physical pages of `addr` (the core's jit_memory, in .text/RX) to a new RW
+// alias -> the dynarec writes through this one and executes through `addr`. Today's
+// libnx API (virtmemReserve was removed): virtmemLock + virtmemFindAslr + Reservation.
 static inline void *mmap(void *addr, size_t len, int prot, int flags, int fd, off_t offset)
 {
-    (void)fd;
-    (void)offset;
+    (void)prot; (void)flags; (void)fd; (void)offset;
 
     size_t size = (len + 0xFFF) &~ 0xFFF;
-	ptr_rw = virtmemReserve(size);
-    if (R_SUCCEEDED(svcMapProcessMemory(ptr_rw, envGetOwnProcessHandle(), (u64)addr, size)))
+    virtmemLock();
+    ptr_rw   = virtmemFindAslr(size, 0);
+    nxjit_rv = ptr_rw ? virtmemAddReservation(ptr_rw, size) : NULL;
+    virtmemUnlock();
+    if (ptr_rw && R_SUCCEEDED(svcMapProcessMemory(ptr_rw, envGetOwnProcessHandle(), (u64)addr, size)))
     {
         return ptr_rw;
     }
@@ -43,6 +49,7 @@ static inline void *mmap(void *addr, size_t len, int prot, int flags, int fd, of
 
 static inline int mprotect(void *addr, size_t len, int prot)
 {
+    (void)addr; (void)len; (void)prot;
     return 0;
 }
 
@@ -50,8 +57,9 @@ static inline int munmap(void *addr, size_t len)
 {
     size_t size = (len + 0xFFF) &~ 0xFFF;
     svcUnmapProcessMemory(ptr_rw, envGetOwnProcessHandle(), (u64)addr, size);
+    if (nxjit_rv) { virtmemLock(); virtmemRemoveReservation(nxjit_rv); virtmemUnlock(); nxjit_rv = NULL; }
     printf("[NXJIT]: Jit closed\n");
-    
+
     return 0;
 }
 
