diff --git a/src/common/file_util.cpp b/src/common/file_util.cpp
index 3168a2622..a15209195 100644
--- a/src/common/file_util.cpp
+++ b/src/common/file_util.cpp
@@ -549,7 +549,15 @@ u64 GetSize(const std::string& filename) {
 
 u64 GetSize(const int fd) {
     file_stat_t buf;
+// The type above is _stat64 on the libretro Windows builds, but with mingw fstat is
+// still the 32-bit one and will not take that pointer. MSVC gets around it with a
+// #define fstat _fstat64; that cannot be done here, because mingw declares fstat after
+// and the macro would change its signature. The 64-bit one is called directly.
+#if defined(_WIN32) && defined(HAVE_LIBRETRO) && !defined(_MSC_VER)
+    if (_fstat64(fd, &buf) != 0) {
+#else
     if (fstat(fd, &buf) != 0) {
+#endif
         LOG_ERROR(Common_Filesystem, "GetSize: stat failed {}: {}", fd, GetLastErrorMsg());
         return 0;
     }
